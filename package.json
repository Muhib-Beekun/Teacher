{"name": "teacher","displayName": "Teacher","description": "Lecture your AI: continuous voice sessions that teach the agent what you meant. Workspace-aware STT and structured agent briefs for Cursor and VS Code.","version": "0.0.55","publisher": "muhib-beekun","icon": "icon.png","engines": {"vscode": "^1.90.0"},"categories": ["Other"],"activationEvents": ["onStartupFinished","onCommand:teacher.startSession","onCommand:teacher.appendSegment","onCommand:teacher.compile","onCommand:teacher.send","onCommand:teacher.dictateHere","onCommand:teacher.endSession","onCommand:teacher.rebuildIndex","onCommand:teacher.setInferenceApiKey","onCommand:teacher.setDeepgramKey","onCommand:teacher.openWebUi","onCommand:teacher.openMicSidecar"],"main": "./out/extension.js","contributes": {"commands": [{"command": "teacher.startSession","title": "Teacher: Start Session","category": "Teacher","icon": {"light": "icon.png","dark": "icon.png"}},{"command": "teacher.appendSegment","title": "Teacher: Append Segment","category": "Teacher"},{"command": "teacher.compile","title": "Teacher: Compile Session","category": "Teacher"},{"command": "teacher.send","title": "Teacher: Send","category": "Teacher"},{"command": "teacher.dictateHere","title": "Teacher: Dictate Here (Verbatim)","category": "Teacher"},{"command": "teacher.endSession","title": "Teacher: End Session","category": "Teacher"},{"command": "teacher.rebuildIndex","title": "Teacher: Rebuild Context Index","category": "Teacher"},{"command": "teacher.setInferenceApiKey","title": "Teacher: Set Inference API Key","category": "Teacher"},{"command": "teacher.setDeepgramKey","title": "Teacher: Set Deepgram API Key","category": "Teacher"},{"command": "teacher.openWebUi","title": "Teacher: Open Web UI","category": "Teacher","icon": {"light": "icon.png","dark": "icon.png"}},{"command": "teacher.openMicSidecar","title": "Teacher: Open Web UI (Browser)","category": "Teacher"}],"configuration": {"title": "Teacher","properties": {"teacher.preview.layout": {"type": "string","enum": ["dual", "single"],"default": "dual","description": "Preview layout in the Teacher panel."},"teacher.compile.live": {"type": "boolean","default": true,"description": "Re-scaffold prompt after each mic pause; manual edits mark brief stale."},"teacher.compile.debounceMs": {"type": "number","minimum": 100,"default": 800,"description": "Debounce time for live compile updates."},"teacher.session.holdChatBox": {"type": "boolean","default": true,"description": "Keep chat input empty until \"Send\" is invoked."},"teacher.context.maxTerms": {"type": "number","minimum": 10,"default": 200,"description": "Max ranked context terms kept in VoiceSessionContext."},"teacher.context.rebuildMode": {"type": "string","enum": ["clearSession", "onFileChange", "eachSegment"],"default": "clearSession","description": "When to rebuild workspace STT index."},"teacher.context.excludeGlobs": {"type": "array","default": ["**/node_modules/**", "**/.git/**", "**/dist/**", "**/out/**", "**/.env*"],"description": "Glob patterns excluded from basename indexing."},"teacher.context.codewordsPath": {"type": "string","default": ".teacher/codewords.txt","description": "Workspace-relative path to STT glossary file."},"teacher.context.codewords": {"type": "array","default": [],"description": "Extra STT glossary terms (merged with file)."},"teacher.compile.mode": {"type": "string","enum": ["teacher", "verbatim", "polish"],"default": "teacher","description": "Compilation mode for the agent brief."},"teacher.compile.provider": {"type": "string","enum": ["auto", "cloud", "ollama", "vscode-lm"],"default": "auto","description": "Inference provider for STT polishing and prompt compilation. 'auto' now prefers vscode.lm (Copilot / authenticated models, no extra key), then Ollama, then cloud LLM. Use 'vscode-lm' to force VS Code Language Model API."},"teacher.send.target": {"type": "string","enum": ["composer", "editor", "clipboard"],"default": "composer","description": "Where Send delivers the compiled brief. composer = Cursor Agent (Option A handoff)."},"teacher.send.autoPaste": {"type": "boolean","default": true,"description": "Auto-open Composer and paste on Send."},"teacher.send.autoSubmit": {"type": "boolean","default": true,"description": "Attempt auto-submit after paste (best-effort)."},"teacher.stt.homonymPass": {"type": "boolean","default": true,"description": "Apply dictionary corrections to STT (workspace symbols, codewords)."},"teacher.stt.provider": {"type": "string","enum": ["auto", "webspeech", "whisper", "deepgram"],"default": "auto","description": "Speech-to-text provider selection."},"teacher.stt.whisper.binaryPath": {"type": "string","default": "","description": "Path to whisper.cpp CLI binary."},"teacher.stt.whisper.modelPath": {"type": "string","default": "","description": "Path to whisper.cpp model file."},"teacher.stt.deepgram.model": {"type": "string","default": "nova-2","description": "Deepgram model identifier."},"teacher.compile.polishStt": {"type": "boolean","default": true,"description": "Fix speech-to-text errors via LLM before compiling."},"teacher.inference.llm.baseUrl": {"type": "string","default": "https://api.openai.com/v1","description": "Base URL for OpenAI-compatible inference API."},"teacher.inference.llm.model": {"type": "string","default": "gpt-4o-mini","description": "Model ID for compile and STT polish."},"teacher.inference.llm.timeoutMs": {"type": "number","minimum": 5000,"default": 45000,"description": "Inference API timeout (ms)."},"teacher.inference.ollama.url": {"type": "string","default": "http://127.0.0.1:11434","description": "Base URL for Ollama API."},"teacher.inference.ollama.model": {"type": "string","default": "qwen2.5-coder:14b","description": "Ollama model for STT polish/compile."},"teacher.inference.ollama.timeoutMs": {"type": "number","minimum": 10000,"default": 120000,"description": "Ollama API timeout (ms)."},"teacher.capture.sidecarPort": {"type": "number","minimum": 1024,"default": 3721,"description": "Localhost port for mic capture sidecar."}}},"scripts": {"build": "tsc -p ./","watch": "tsc -watch -p ./","package": "npm run build && npx @vscode/vsce package --allow-missing-repository --allow-star-activation","publish:ovsx": "node tools/publish-ovsx.mjs","mic-sidecar": "node tools/mic-sidecar-server.mjs","test:mic-sidecar": "node tools/test-mic-sidecar.mjs","test:grok": "node tools/test-grok.mjs","test:web-app": "npm run build && node tools/test-web-app.mjs","test:compiler": "npm run build && node tools/test-compiler.mjs","test:stt-context": "npm run build && node tools/test-stt-context.mjs","test:compile-eval": "node tools/eval-compile.mjs --provider grok","eval:compile": "node tools/eval-compile.mjs --compare","render:icon": "node tools/render-icon.mjs","vscode:prepublish": "npm run render:icon && npm run build"}}