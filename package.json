{
    "name": "teacher",
    "displayName": "Teacher",
    "description": "Lecture your AI: continuous voice sessions that teach the agent what you meant. Workspace-aware STT and structured agent briefs for Cursor and VS Code.",
    "version": "0.0.47",
    "publisher": "muhib-beekun",
    "icon": "icon.png",
    "author": "Muhib Beekun",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Muhib-Beekun/Teacher.git"
    },
    "homepage": "https://github.com/Muhib-Beekun/Teacher#readme",
    "bugs": {
        "url": "https://github.com/Muhib-Beekun/Teacher/issues"
    },
    "engines": {
        "vscode": "^1.92.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "voice",
        "stt",
        "cursor",
        "teacher"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onStartupFinished",
        "onCommand:teacher.startSession",
        "onCommand:teacher.appendSegment",
        "onCommand:teacher.compile",
        "onCommand:teacher.send",
        "onCommand:teacher.dictateHere",
        "onCommand:teacher.endSession",
        "onCommand:teacher.rebuildIndex",
        "onCommand:teacher.setInferenceApiKey",
        "onCommand:teacher.setDeepgramKey",
        "onCommand:teacher.openWebUi",
        "onCommand:teacher.openMicSidecar"
    ],
    "contributes": {
        "commands": [
            {
                "command": "teacher.startSession",
                "title": "Teacher: Start Session",
                "category": "Teacher",
                "icon": {
                    "light": "icon.png",
                    "dark": "icon.png"
                }
            },
            {
                "command": "teacher.appendSegment",
                "title": "Teacher: Append Segment",
                "category": "Teacher"
            },
            {
                "command": "teacher.compile",
                "title": "Teacher: Compile Session",
                "category": "Teacher"
            },
            {
                "command": "teacher.send",
                "title": "Teacher: Send",
                "category": "Teacher"
            },
            {
                "command": "teacher.dictateHere",
                "title": "Teacher: Dictate Here (Verbatim)",
                "category": "Teacher"
            },
            {
                "command": "teacher.endSession",
                "title": "Teacher: End Session",
                "category": "Teacher"
            },
            {
                "command": "teacher.rebuildIndex",
                "title": "Teacher: Rebuild Context Index",
                "category": "Teacher"
            },
            {
                "command": "teacher.setInferenceApiKey",
                "title": "Teacher: Set Inference API Key",
                "category": "Teacher"
            },
            {
                "command": "teacher.setDeepgramKey",
                "title": "Teacher: Set Deepgram API Key",
                "category": "Teacher"
            },
            {
                "command": "teacher.openWebUi",
                "title": "Teacher: Open Web UI",
                "category": "Teacher",
                "icon": {
                    "light": "icon.png",
                    "dark": "icon.png"
                }
            },
            {
                "command": "teacher.openMicSidecar",
                "title": "Teacher: Open Web UI (Browser)",
                "category": "Teacher",
                "icon": {
                    "light": "icon.png",
                    "dark": "icon.png"
                }
            }
        ],
        "configuration": {
            "title": "Teacher",
            "properties": {
                "teacher.preview.layout": {
                    "type": "string",
                    "enum": [
                        "dual",
                        "single"
                    ],
                    "default": "dual",
                    "description": "Preview layout shown in the Teacher panel."
                },
                "teacher.compile.live": {
                    "type": "boolean",
                    "default": true,
                    "description": "Re-scaffold the compiled prompt after each appended segment."
                },
                "teacher.compile.debounceMs": {
                    "type": "number",
                    "default": 800,
                    "minimum": 100,
                    "description": "Debounce for live compile updates while receiving speech segments."
                },
                "teacher.session.holdChatBox": {
                    "type": "boolean",
                    "default": true,
                    "description": "Keep chat input empty until Teacher Send is explicitly invoked."
                },
                "teacher.context.maxTerms": {
                    "type": "number",
                    "default": 200,
                    "minimum": 10,
                    "description": "Maximum ranked context terms to keep in VoiceSessionContext."
                },
                "teacher.context.rebuildMode": {
                    "type": "string",
                    "enum": [
                        "clearSession",
                        "onFileChange",
                        "eachSegment"
                    ],
                    "default": "clearSession",
                    "description": "When to rebuild the workspace STT index. clearSession = on Clear session only (conservative). onFileChange = debounced async rebuild when files change. eachSegment = after every mic pause."
                },
                "teacher.context.excludeGlobs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/node_modules/**",
                        "**/.git/**",
                        "**/dist/**",
                        "**/out/**",
                        "**/.env*"
                    ],
                    "description": "Glob patterns excluded from basename indexing."
                },
                "teacher.context.codewordsPath": {
                    "type": "string",
                    "default": ".teacher/codewords.txt",
                    "description": "Workspace-relative path to your STT glossary (one term per line). Gitignored; created from template on first run."
                },
                "teacher.context.codewords": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Extra STT glossary terms merged with the codewords file (no file needed)."
                },
                "teacher.compile.mode": {
                    "type": "string",
                    "enum": [
                        "teacher",
                        "verbatim",
                        "polish"
                    ],
                    "default": "teacher",
                    "description": "teacher = structured agent brief with superseded block. verbatim = joined segments only. polish = deferred."
                },
                "teacher.send.target": {
                    "type": "string",
                    "enum": [
                        "composer",
                        "editor",
                        "clipboard"
                    ],
                    "default": "composer",
                    "description": "Where Send delivers the compiled brief. composer = Cursor Agent (Option A handoff)."
                },
                "teacher.send.autoPaste": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically open Composer and paste the compiled brief on Send."
                },
                "teacher.send.autoSubmit": {
                    "type": "boolean",
                    "default": true,
                    "description": "After paste, attempt to submit the agent prompt automatically (best-effort; depends on Cursor version)."
                },
                "teacher.stt.homonymPass": {
                    "type": "boolean",
                    "default": true,
                    "description": "Apply vectorless dictionary corrections to STT (workspace symbols, codewords). Always on in browser path; this setting affects whisper/deepgram-only fallback."
                },
                "teacher.stt.provider": {
                    "type": "string",
                    "enum": ["auto", "webspeech", "whisper", "deepgram"],
                    "default": "auto",
                    "description": "STT provider. auto = whisper if configured, else Deepgram if key set, else browser Web Speech."
                },
                "teacher.stt.whisper.binaryPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to whisper.cpp CLI (whisper-cli or main.exe)."
                },
                "teacher.stt.whisper.modelPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to whisper.cpp GGML/GGUF model file."
                },
                "teacher.stt.deepgram.model": {
                    "type": "string",
                    "default": "nova-2",
                    "description": "Deepgram model id (BYOK)."
                },
                "teacher.compile.provider": {
                    "type": "string",
                    "enum": ["auto", "cloud", "ollama"],
                    "default": "auto",
                    "description": "Compile provider. auto = Ollama if running locally, else cloud inference API. verbatim mode skips LLM."
                },
                "teacher.compile.polishStt": {
                    "type": "boolean",
                    "default": true,
                    "description": "Fix speech-to-text errors via LLM before compiling (requires API key or Ollama)."
                },
                "teacher.inference.llm.baseUrl": {
                    "type": "string",
                    "default": "https://api.openai.com/v1",
                    "description": "OpenAI-compatible API base URL for compile and STT polish."
                },
                "teacher.inference.llm.model": {
                    "type": "string",
                    "default": "gpt-4o-mini",
                    "description": "Model id for compile and STT polish (OpenAI-compatible hosts)."
                },
                "teacher.inference.llm.timeoutMs": {
                    "type": "number",
                    "default": 45000,
                    "minimum": 5000,
                    "description": "Inference API timeout in milliseconds."
                },
                "teacher.inference.ollama.url": {
                    "type": "string",
                    "default": "http://127.0.0.1:11434",
                    "description": "Ollama API base URL for compile step."
                },
                "teacher.inference.ollama.model": {
                    "type": "string",
                    "default": "qwen2.5-coder:14b",
                    "description": "Ollama model for STT polish and compile (e.g. qwen2.5-coder:14b). Auto-fallback if tag differs."
                },
                "teacher.inference.ollama.timeoutMs": {
                    "type": "number",
                    "default": 120000,
                    "minimum": 10000,
                    "description": "Ollama API timeout in milliseconds."
                },
                "teacher.capture.sidecarPort": {
                    "type": "number",
                    "default": 3721,
                    "minimum": 1024,
                    "description": "Localhost port for Chrome/Edge mic capture page (Cursor webviews cannot access the microphone)."
                }
            }
        }
    },
    "scripts": {
        "build": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "npm run build && npx @vscode/vsce package --allow-missing-repository --allow-star-activation",
        "publish:ovsx": "node tools/publish-ovsx.mjs",
        "mic-sidecar": "node tools/mic-sidecar-server.mjs",
        "test:mic-sidecar": "node tools/test-mic-sidecar.mjs",
        "test:grok": "node tools/test-grok.mjs",
        "test:web-app": "npm run build && node tools/test-web-app.mjs",
        "test:compiler": "npm run build && node tools/test-compiler.mjs",
        "test:stt-context": "npm run build && node tools/test-stt-context.mjs",
        "test:compile-eval": "node tools/eval-compile.mjs --provider grok",
        "eval:compile": "node tools/eval-compile.mjs --compare",
        "render:icon": "node tools/render-icon.mjs",
        "vscode:prepublish": "npm run render:icon && npm run build"
    },
    "devDependencies": {
        "@types/node": "^20.14.10",
        "@types/vscode": "^1.92.0",
        "@vscode/vsce": "^3.6.0",
        "puppeteer": "^24.10.0",
        "typescript": "^5.5.4"
    }
}