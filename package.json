{
    "name": "teacher",
    "displayName": "Teacher",
    "description": "Lecture your AI: continuous voice sessions that teach the agent what you meant. Workspace-aware STT and structured agent briefs for Cursor and VS Code.",
    "version": "0.1.5",
    "publisher": "muhib-beekun",
    "icon": "icon.png",
    "author": "Muhib Beekun",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Muhib-Beekun/Teacher.git"
    },
    "homepage": "https://github.com/Muhib-Beekun/Teacher#readme",
    "bugs": {
        "url": "https://github.com/Muhib-Beekun/Teacher/issues"
    },
    "sponsor": {
        "url": "https://github.com/sponsors/Muhib-Beekun"
    },
    "engines": {
        "vscode": "^1.92.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "voice",
        "stt",
        "cursor",
        "teacher"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onStartupFinished",
        "onCommand:teacher.startSession",
        "onCommand:teacher.appendSegment",
        "onCommand:teacher.compile",
        "onCommand:teacher.send",
        "onCommand:teacher.dictateHere",
        "onCommand:teacher.endSession",
        "onCommand:teacher.rebuildIndex",
        "onCommand:teacher.setInferenceApiKey",
        "onCommand:teacher.setDeepgramKey",
        "onCommand:teacher.openWebUi",
        "onCommand:teacher.openMicSidecar",
        "onCommand:teacher.checkForUpdates",
        "onCommand:teacher.updateFromOpenVsx"
    ],
    "contributes": {
        "commands": [
            {
                "command": "teacher.startSession",
                "title": "Teacher: Start Session",
                "category": "Teacher",
                "icon": {
                    "light": "icon.png",
                    "dark": "icon.png"
                }
            },
            {
                "command": "teacher.appendSegment",
                "title": "Teacher: Append Segment",
                "category": "Teacher"
            },
            {
                "command": "teacher.compile",
                "title": "Teacher: Compile Session",
                "category": "Teacher"
            },
            {
                "command": "teacher.send",
                "title": "Teacher: Send",
                "category": "Teacher"
            },
            {
                "command": "teacher.dictateHere",
                "title": "Teacher: Dictate Here (Verbatim)",
                "category": "Teacher"
            },
            {
                "command": "teacher.endSession",
                "title": "Teacher: End Session",
                "category": "Teacher"
            },
            {
                "command": "teacher.rebuildIndex",
                "title": "Teacher: Rebuild Context Index",
                "category": "Teacher"
            },
            {
                "command": "teacher.setInferenceApiKey",
                "title": "Teacher: Set Inference API Key",
                "category": "Teacher"
            },
            {
                "command": "teacher.setDeepgramKey",
                "title": "Teacher: Set Deepgram API Key",
                "category": "Teacher"
            },
            {
                "command": "teacher.openWebUi",
                "title": "Teacher: Open Web UI",
                "category": "Teacher",
                "icon": {
                    "light": "icon.png",
                    "dark": "icon.png"
                }
            },
            {
                "command": "teacher.openMicSidecar",
                "title": "Teacher: Open Web UI (Browser)",
                "category": "Teacher",
                "icon": {
                    "light": "icon.png",
                    "dark": "icon.png"
                }
            },
            {
                "command": "teacher.checkForUpdates",
                "title": "Teacher: Check for Updates",
                "category": "Teacher"
            },
            {
                "command": "teacher.updateFromOpenVsx",
                "title": "Teacher: Update from Open VSX",
                "category": "Teacher"
            }
        ],
        "configuration": {
            "title": "Teacher",
            "properties": {
                "teacher.preview.layout": {
                    "type": "string",
                    "enum": [
                        "dual",
                        "single"
                    ],
                    "default": "dual",
                    "description": "Preview layout shown in the Teacher panel."
                },
                "teacher.compile.live": {
                    "type": "boolean",
                    "default": true,
                    "description": "Re-scaffold the agent prompt after each mic pause. Manual edits in Your Words mark the brief stale (refresh button glows) until you refresh."
                },
                "teacher.compile.debounceMs": {
                    "type": "number",
                    "default": 800,
                    "minimum": 100,
                    "description": "Debounce for live compile updates while receiving speech segments."
                },
                "teacher.session.holdChatBox": {
                    "type": "boolean",
                    "default": true,
                    "description": "Keep chat input empty until Teacher Send is explicitly invoked."
                },
                "teacher.context.maxTerms": {
                    "type": "number",
                    "default": 200,
                    "minimum": 10,
                    "description": "Maximum ranked context terms to keep in VoiceSessionContext."
                },
                "teacher.context.rebuildMode": {
                    "type": "string",
                    "enum": [
                        "clearSession",
                        "onFileChange",
                        "eachSegment"
                    ],
                    "default": "clearSession",
                    "description": "When to rebuild the workspace STT index. clearSession = on Clear session only (conservative). onFileChange = debounced async rebuild when files change. eachSegment = after every mic pause."
                },
                "teacher.context.excludeGlobs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/node_modules/**",
                        "**/.git/**",
                        "**/dist/**",
                        "**/out/**",
                        "**/.env*"
                    ],
                    "description": "Glob patterns excluded from basename indexing."
                },
                "teacher.context.codewordsPath": {
                    "type": "string",
                    "default": ".teacher/codewords.txt",
                    "description": "Workspace-relative path to your STT glossary (one term per line). Gitignored; created from template on first run."
                },
                "teacher.context.codewords": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Extra STT glossary terms merged with the codewords file (no file needed)."
                },
                "teacher.compile.mode": {
                    "type": "string",
                    "enum": [
                        "teacher",
                        "verbatim",
                        "polish"
                    ],
                    "default": "teacher",
                    "description": "teacher = structured agent brief with superseded block. verbatim = joined segments only. polish = deferred."
                },
                "teacher.send.target": {
                    "type": "string",
                    "enum": [
                        "composer",
                        "editor",
                        "clipboard"
                    ],
                    "default": "composer",
                    "description": "Where Send delivers the compiled brief. composer = Cursor Agent (Option A handoff)."
                },
                "teacher.send.autoPaste": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically open Composer and paste the compiled brief on Send."
                },
                "teacher.send.autoSubmit": {
                    "type": "boolean",
                    "default": true,
                    "description": "After paste, attempt to submit the agent prompt automatically (best-effort; depends on Cursor version)."
                },
                "teacher.send.dispatchMode": {
                    "type": "string",
                    "enum": [
                        "handoff",
                        "raw",
                        "relay"
                    ],
                    "default": "handoff",
                    "description": "Default packet for POST /api/dispatch (and /api/send with mode). handoff = voice session packet (compile). raw = exact text, no compile. relay = fixed A2A auditor template + meta fields, no compile."
                },
                "teacher.stt.homonymPass": {
                    "type": "boolean",
                    "default": true,
                    "description": "Apply vectorless dictionary corrections to STT (workspace symbols, codewords). Always on in browser path; this setting affects whisper/deepgram-only fallback."
                },
                "teacher.stt.provider": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "webspeech",
                        "whisper",
                        "deepgram"
                    ],
                    "default": "auto",
                    "description": "STT provider. auto = whisper if configured, else Deepgram if key set, else browser Web Speech."
                },
                "teacher.stt.whisper.binaryPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to whisper.cpp CLI (whisper-cli or main.exe)."
                },
                "teacher.stt.whisper.modelPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to whisper.cpp GGML/GGUF model file."
                },
                "teacher.stt.deepgram.model": {
                    "type": "string",
                    "default": "nova-2",
                    "description": "Deepgram model id (BYOK)."
                },
                "teacher.stt.browserRecovery.maxRetries": {
                    "type": "number",
                    "default": 4,
                    "minimum": 3,
                    "maximum": 7,
                    "description": "Max consecutive browser speech retries before STT fallback (Web Speech recovery)."
                },
                "teacher.stt.browserRecovery.enableAutoFallback": {
                    "type": "boolean",
                    "default": true,
                    "description": "After browser speech retries are exhausted, fall back to Whisper/Deepgram when configured."
                },
                "teacher.stt.browserRecovery.resetWindowSec": {
                    "type": "number",
                    "default": 75,
                    "minimum": 60,
                    "maximum": 90,
                    "description": "Seconds of stable browser speech before the consecutive failure counter resets."
                },
                "teacher.stt.browserRecovery.audibleAlerts": {
                    "type": "boolean",
                    "default": true,
                    "description": "Play short alert tones when browser speech recovery retries or falls back (helps when the tab is not focused)."
                },
                "teacher.stt.browserRecovery.alertVolume": {
                    "type": "number",
                    "default": 0.35,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Volume for browser speech recovery alert tones (0–1)."
                },
                "teacher.stt.browserRecovery.alertsOnlyWhenHidden": {
                    "type": "boolean",
                    "default": false,
                    "description": "When true, retry/recovered tones play only when the Teacher tab is in the background. Fallback tones always play."
                },
                "teacher.stt.sessionCues.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Play very quiet start/stop tones when mic listening begins and when you pause to commit."
                },
                "teacher.stt.sessionCues.volume": {
                    "type": "number",
                    "default": 0.12,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Volume for mic session start/stop cues (0 = off, default 0.12)."
                },
                "teacher.compile.provider": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "cloud",
                        "ollama",
                        "vscode-lm"
                    ],
                    "default": "auto",
                    "description": "Compile provider. auto = Ollama if running, else cloud API key, else VS Code LM (GitHub Copilot). AI agents: set to 'cloud' when configuring a non-OpenAI cloud provider so Ollama is skipped. On remote SSH/WSL hosts, auto skips vscode-lm unless teacher.compile.vscodeLm.allowOnRemote is true."
                },
                "teacher.compile.vscodeLm.allowOnRemote": {
                    "type": "boolean",
                    "default": false,
                    "description": "Allow vscode.lm (GitHub Copilot) for compile on remote extension hosts. Default false because vscode.lm often returns empty output over SSH; use cloud or Ollama on remote instead."
                },
                "teacher.compile.polishStt": {
                    "type": "boolean",
                    "default": true,
                    "description": "Fix speech-to-text errors via LLM before compiling (requires API key or Ollama)."
                },
                "teacher.inference.llm.baseUrl": {
                    "type": "string",
                    "default": "https://api.openai.com/v1",
                    "description": "OpenAI-compatible API base URL for compile and STT polish. AI agents: set this instead of INFERENCE_BASE_URL in .env to avoid locking the Settings UI. See AGENTS.md."
                },
                "teacher.inference.llm.model": {
                    "type": "string",
                    "default": "gpt-4o-mini",
                    "description": "Model id for compile and STT polish (OpenAI-compatible hosts). AI agents: set this instead of INFERENCE_MODEL in .env. See AGENTS.md."
                },
                "teacher.inference.llm.timeoutMs": {
                    "type": "number",
                    "default": 45000,
                    "minimum": 5000,
                    "description": "Inference API timeout in milliseconds."
                },
                "teacher.inference.ollama.url": {
                    "type": "string",
                    "default": "http://127.0.0.1:11434",
                    "description": "Ollama API base URL for compile step."
                },
                "teacher.inference.ollama.model": {
                    "type": "string",
                    "default": "qwen2.5-coder:14b",
                    "description": "Ollama model for STT polish and compile (e.g. qwen2.5-coder:14b). Auto-fallback if tag differs."
                },
                "teacher.inference.ollama.timeoutMs": {
                    "type": "number",
                    "default": 120000,
                    "minimum": 10000,
                    "description": "Ollama API timeout in milliseconds."
                },
                "teacher.capture.sidecarPort": {
                    "type": "number",
                    "default": 3721,
                    "minimum": 1024,
                    "description": "Localhost port for Chrome/Edge mic capture page (Cursor webviews cannot access the microphone)."
                }
            }
        }
    },
    "scripts": {
        "build": "tsc -p ./ && node esbuild.web.mjs",
        "build:web": "node esbuild.web.mjs",
        "watch": "tsc -watch -p ./",
        "package": "npm run build && npx @vscode/vsce package --allow-missing-repository --allow-star-activation",
        "publish:ovsx": "node tools/publish-ovsx.mjs",
        "mic-sidecar": "node tools/mic-sidecar-server.mjs",
        "test:mic-sidecar": "node tools/test-mic-sidecar.mjs",
        "test:grok": "node tools/test-grok.mjs",
        "test:web-app": "npm run build && node tools/test-web-app.mjs",
        "test:compiler": "npm run build && node tools/test-compiler.mjs",
        "test:unit": "npx vitest run",
        "test:dispatch": "npm run build && node tools/test-relay-dispatch.mjs",
        "test:ui": "npx playwright test",
        "test:compile-providers": "npm run build && node tools/test-compile-providers.mjs",
        "test:stt-context": "npm run build && node tools/test-stt-context.mjs",
        "test:compile-eval": "node tools/eval-compile.mjs --provider grok",
        "eval:compile": "node tools/eval-compile.mjs --compare",
        "render:icon": "node tools/render-icon.mjs",
        "build:web:dev": "node esbuild.web.mjs --dev",
        "vscode:prepublish": "npm run render:icon && npm run build"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@preact/signals": "^2.9.2",
        "@testing-library/preact": "^3.2.4",
        "@types/node": "^20.14.10",
        "@types/vscode": "^1.92.0",
        "@vscode/vsce": "^3.6.0",
        "esbuild": "^0.28.1",
        "jsdom": "^29.1.1",
        "preact": "^10.29.4",
        "puppeteer": "^24.10.0",
        "typescript": "^5.5.4",
        "vitest": "^4.1.9"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
