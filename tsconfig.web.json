{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "types": [],
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "rootDir": "src"
    },
    "include": ["src/web-ui/**/*", "src/shared/**/*"]
}
