# Copy to `.env` in the workspace root (gitignored).
#
# PREFERRED: Use Teacher Settings UI or VS Code settings (settings.json).
# AI agents: see AGENTS.md for the non-locking configuration path.
#
# WARNING: INFERENCE_BASE_URL and INFERENCE_MODEL here LOCK those fields
# in the Teacher Settings UI. Only use .env for team config, remote SSH
# workspaces, or when VS Code settings aren't practical.

# ── Cloud inference (compile + STT polish) ─────────────────────────────
# Shipped extension defaults: OpenAI (https://api.openai.com/v1, gpt-4o-mini).
# Or pick a preset in Teacher Settings and save an API key there.

INFERENCE_API_KEY=

# Optional overrides (any OpenAI-compatible host):
# INFERENCE_BASE_URL=https://api.openai.com/v1
# INFERENCE_MODEL=gpt-4o-mini

# Provider key aliases (first non-empty wins):
# OPENAI_API_KEY=
# XAI_API_KEY=          # xAI Grok
# GROK_API_KEY=         # legacy alias for xAI

# Provider examples (uncomment one block):
# OpenAI:
# INFERENCE_BASE_URL=https://api.openai.com/v1
# INFERENCE_MODEL=gpt-4o-mini
# xAI Grok:
# INFERENCE_BASE_URL=https://api.x.ai/v1
# INFERENCE_MODEL=grok-4-fast-reasoning
# Groq:
# INFERENCE_BASE_URL=https://api.groq.com/openai/v1
# INFERENCE_MODEL=llama-3.3-70b-versatile
# DeepSeek:
# INFERENCE_BASE_URL=https://api.deepseek.com/v1
# INFERENCE_MODEL=deepseek-chat
# OpenRouter:
# INFERENCE_BASE_URL=https://openrouter.ai/api/v1
# INFERENCE_MODEL=openai/gpt-4o-mini
# Together:
# INFERENCE_BASE_URL=https://api.together.xyz/v1
# INFERENCE_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
# Fireworks:
# INFERENCE_BASE_URL=https://api.fireworks.ai/inference/v1
# INFERENCE_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
# Mistral:
# INFERENCE_BASE_URL=https://api.mistral.ai/v1
# INFERENCE_MODEL=mistral-small-latest
# Cerebras:
# INFERENCE_BASE_URL=https://api.cerebras.ai/v1
# INFERENCE_MODEL=llama-3.3-70b
# Google Gemini (OpenAI-compatible):
# INFERENCE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# INFERENCE_MODEL=gemini-2.0-flash
# Ollama OpenAI-compatible API:
# INFERENCE_BASE_URL=http://127.0.0.1:11434/v1
# INFERENCE_MODEL=qwen2.5-coder:14b

# ── Speech-to-text (optional) ───────────────────────────────────────────
# DEEPGRAM_API_KEY=

# ── Local compile (no cloud key) ──────────────────────────────────────────
# Run Ollama, then set Compile provider to Auto or Local Ollama in Settings.
# OLLAMA_HOST=http://127.0.0.1:11434
