# Environment variables (copy to `.env` in your workspace root — never commit)

# ── Cloud inference (compile + STT polish) ─────────────────────────────
# Shipped extension defaults: OpenAI (https://api.openai.com/v1, gpt-4o-mini).
# Or use Teacher Settings UI to pick a preset and save your API key.

INFERENCE_API_KEY=

# Optional overrides (any OpenAI-compatible host):
# INFERENCE_BASE_URL=https://api.openai.com/v1
# INFERENCE_MODEL=gpt-4o-mini

# Provider key aliases (first non-empty wins):
# OPENAI_API_KEY=
# XAI_API_KEY=          # xAI Grok
# GROK_API_KEY=         # legacy alias for xAI

# Provider examples (uncomment one block):
# OpenAI:
# INFERENCE_BASE_URL=https://api.openai.com/v1
# INFERENCE_MODEL=gpt-4o-mini
# xAI Grok:
# INFERENCE_BASE_URL=https://api.x.ai/v1
# INFERENCE_MODEL=grok-4-fast-reasoning
# Groq:
# INFERENCE_BASE_URL=https://api.groq.com/openai/v1
# INFERENCE_MODEL=llama-3.3-70b-versatile

# ── Speech-to-text (optional) ───────────────────────────────────────────
# DEEPGRAM_API_KEY=

# ── Local compile (no cloud key) ──────────────────────────────────────────
# Run Ollama, then set Compile provider to Auto or Local Ollama in Settings.
# OLLAMA_HOST=http://127.0.0.1:11434
